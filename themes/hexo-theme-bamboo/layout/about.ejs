<section class="inner-page about-page">
  <header class="page-heading">
    <span class="letterhead" lang="en"><span class="letterhead-rule"></span> FROM THE POSTMASTER</span>
    <h1>关于 Ryo</h1>
  </header>
  <div class="about-letter">
    <div>
      <h2>你好，我是 Ryo。</h2>
      <p>我做全栈开发，这座小邮局是我的技术博客。这里收着 React 和 Node.js 的学习笔记，也有调网络、配服务器时留下的踩坑记录。</p>
      <p>咕咕嘎嘎守着分拣台，Doro 背上信封出门。挑一个感兴趣的主题，就能沿着它们的邮路翻下去。</p>
      <% const email = theme.sidebar.widget_library.side_blogger.social.find(item => item.url.startsWith('mailto:')); %>
      <div class="about-links">
        <% if (email) { %><a class="button button-ink" href="<%= email.url %>"><%- partial('_postal/icon', { name: 'mail' }) %>给我写信</a><% } %>
        <% if (theme.Github.on) { %><a class="button button-paper" href="<%= theme.Github.url %>">GitHub</a><% } %>
        <a class="text-link" href="<%= url_for('visualization-layout/') %>">可视化实验</a>
      </div>
      <p class="about-signature">Ryo</p>
    </div>
    <figure class="about-picture"><img src="<%= url_for('images/gugu-doro/web/anime-02-coastal-train.jpg') %>" srcset="<%= url_for('images/gugu-doro/web/thumbs/anime-02-coastal-train.jpg') %> 480w, <%= url_for('images/gugu-doro/web/anime-02-coastal-train.jpg') %> 1672w" sizes="(max-width: 720px) 78vw, 380px" width="1672" height="941" alt="咕嘎与 Doro 坐在沿海列车上，一起看向窗外的大海" loading="lazy"></figure>
  </div>
  <div class="about-counts">
    <% [[site.posts.length, '封来信', config.archive_dir], [site.categories.length, '个分类', config.category_dir], [site.tags.length, '个标签', config.tag_dir]].forEach(([count, label, path]) => { %>
      <a href="<%= url_for(path + '/') %>"><strong><%= count %></strong><span><%= label %></span></a>
    <% }) %>
  </div>
  <% if (theme.baseInfo.on || theme.skills.on) { %>
    <details class="about-profile">
      <summary>个人资料与技能</summary>
      <% if (theme.baseInfo.on) { %><dl>
        <% [['年龄',theme.baseInfo.age], ['性别',theme.baseInfo.sex], ['所在地',theme.baseInfo.coordinate], ['状态',theme.baseInfo.status]].forEach(([label,value]) => { if (value) { %><div><dt><%= label %></dt><dd><%= value %></dd></div><% } }) %>
      </dl><% } %>
      <% if (theme.skills.on && theme.skills.data) { %><ul class="skill-list" aria-label="技术栈"><% Object.entries(theme.skills.data).forEach(([name, skill]) => { %>
        <li><%= name %> <span><%= skill.percent %></span></li>
      <% }) %></ul><% } %>
    </details>
  <% } %>
</section>
