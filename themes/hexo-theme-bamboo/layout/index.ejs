<% const allPaths = site.posts.map(post => url_for(post.path)); %>
<% if (page.current === 1) { %>
  <section class="airmail" aria-labelledby="office-title">
    <div class="airmail-copy">
      <div class="letterhead" lang="en"><span class="letterhead-rule"></span> RYO’S PERSONAL POST</div>
      <h1 id="office-title">咕嘎邮便局<span class="title-stop" aria-hidden="true">。</span></h1>
      <p>我是 Ryo，在这里写全栈开发手记。<br>咕咕嘎嘎分拣，Doro 把信送到你手里。</p>
      <% if (allPaths.length) { %>
        <div class="hero-actions">
          <a class="button button-ink" href="#letters"><%- partial('_postal/icon', { name: 'open' }) %>翻阅来信</a>
          <a class="button button-paper" href="<%= allPaths[Math.floor(Math.random() * allPaths.length)] %>" data-random-letter><%- partial('_postal/icon', { name: 'dice' }) %>随机拆信</a>
        </div>
      <% } %>
    </div>
    <div class="airmail-art">
      <div class="picture-stamp">
        <figure class="stamp-paper">
          <img src="<%= url_for('images/gugu-doro/web/anime-01-seaside-post.jpg') %>" srcset="<%= url_for('images/gugu-doro/web/thumbs/anime-01-seaside-post.jpg') %> 480w, <%= url_for('images/gugu-doro/web/anime-01-seaside-post-960.jpg') %> 960w, <%= url_for('images/gugu-doro/web/anime-01-seaside-post.jpg') %> 1672w" sizes="(max-width: 720px) 82vw, (max-width: 1240px) 38vw, 455px" width="1672" height="941" fetchpriority="high" alt="咕嘎在海边投递信件，Doro 帮她扶住被风吹起的遮阳帽">
          <figcaption><span lang="en">GUGU &amp; DORO</span><span><%- partial('_postal/icon', { name: 'plane' }) %><span lang="en">AIR MAIL</span></span></figcaption>
        </figure>
      </div>
      <div class="postmark" aria-hidden="true"><div class="postmark-ring"><span>咕 嘎 邮 便</span><%- partial('_postal/icon', { name: 'mail' }) %><small>RYO · POST</small></div><i></i></div>
    </div>
  </section>
<% } %>
<div class="mailroom<%= page.current === 1 ? '' : ' inner-room' %>">
  <section id="letters" aria-labelledby="letters-title" tabindex="-1">
    <div class="section-heading">
      <div><span class="section-symbol"><%- partial('_postal/icon', { name: 'box' }) %></span>
        <% if (page.current === 1) { %><h2 id="letters-title">最新来信</h2><% } else { %><h1 id="letters-title">往期来信</h1><% } %>
        <span class="count"><%= site.posts.length %> 封</span>
      </div>
      <a class="text-link" href="<%= url_for('archives/') %>">全部归档</a>
    </div>
    <%- partial('_postal/mail-list', { posts: page.posts }) %>
    <%- partial('_postal/pagination') %>
  </section>
  <aside class="mail-sidebar" aria-label="邮局侧栏">
    <%- partial('_postal/on-duty') %>
    <section class="sorting-box">
      <div class="side-heading"><h2><%- partial('_postal/icon', { name: 'folder' }) %> 分类信箱</h2><a class="text-link" href="<%= url_for('categories/') %>">全部</a></div>
      <div class="sorting-links">
        <% site.categories.sort('length', -1).limit(5).each(category => { %>
          <a href="<%= url_for(category.path) %>"><span><%= category.name %></span><span class="sorting-count"><%= category.length %></span></a>
        <% }) %>
      </div>
    </section>
  </aside>
</div>
<% if (page.current === 1 && allPaths.length) { %>
  <script type="application/json" id="letter-routes"><%- JSON.stringify(allPaths).replace(/</g, '\\u003c') %></script>
<% } %>
