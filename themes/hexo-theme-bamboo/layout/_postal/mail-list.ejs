<% if (!posts.length) { %><p class="empty-note">信箱里还没有来信。</p><% } %>
<div class="letters-list">
  <% posts.each(post => {
    const category = post.categories && post.categories.last();
    const stamp = postal_stamp(category && category.name);
    const cover = postal_cover(post);
    const summary = postal_excerpt(post);
  %>
    <article class="letter">
      <a class="letter-picture" href="<%= url_for(post.path) %>" tabindex="-1" aria-hidden="true">
        <span class="mini-stamp"><img src="<%= url_for(cover.thumbnail) %>" alt="" width="480" height="300" loading="lazy" decoding="async"></span>
      </a>
      <div class="letter-body">
        <div class="letter-meta">
          <% if (category) { %><a class="category-ink ink-<%= stamp %>" href="<%= url_for(category.path) %>"><%= category.name %></a><span aria-hidden="true">/</span><% } %>
          <time datetime="<%= date(post.date, 'YYYY-MM-DD') %>"><%= date(post.date, 'YYYY.MM.DD') %></time>
        </div>
        <h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3>
        <% if (summary) { %><p><%= summary %></p><% } %>
      </div>
    </article>
  <% }) %>
</div>
