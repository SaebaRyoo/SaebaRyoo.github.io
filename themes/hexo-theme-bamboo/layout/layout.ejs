<%
  const office = '咕嘎邮便局';
  const navKey = is_home() ? 'home' : is_archive() ? 'archive' : (is_category() || is_tag() || page.layout === 'categories' || page.layout === 'tags') ? 'topics' : page.path.startsWith('about/') ? 'about' : '';
  const issue = [page.year, page.month && String(page.month).padStart(2, '0')].filter(Boolean).join(' / ');
  const sectionTitle = is_home() ? office : is_archive() ? ['文章归档', issue].filter(Boolean).join(' · ') : page.category || page.tag || ({categories: '分类信箱', tags: '标签索引', about: '关于 Ryo'})[page.layout] || page.title || office;
  const title = [sectionTitle, page.current > 1 ? '第 ' + page.current + ' 页' : '', config.title].filter(Boolean).join(' · ');
  const description = strip_html(page.description || config.description);
%>
<!doctype html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="description" content="<%= description %>">
  <meta property="og:title" content="<%= title %>">
  <meta property="og:description" content="<%= description %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:image" content="<%= full_url_for(is_post() ? postal_cover(page).src : 'images/gugu-doro/web/anime-01-seaside-post.jpg') %>">
  <link rel="canonical" href="<%= full_url_for(page.path) %>">
  <link rel="icon" href="<%= url_for('post-office/gugu-icon.png') %>" type="image/png">
  <title><%= title %></title>
  <script>
    try {
      var storedDark = localStorage.getItem('dark');
      document.documentElement.dataset.theme = (storedDark === null ? matchMedia('(prefers-color-scheme: dark)').matches : storedDark === 'true') ? 'dark' : 'light';
    } catch (_) {}
  </script>
  <link rel="stylesheet" href="<%= url_for('post-office/post.css') %>">
  <script defer src="<%= url_for('post-office/post.js') %>"></script>
</head>
<body>
  <%- partial('_postal/symbols') %>
  <a class="skip" href="#main-content">跳到正文</a>
  <header class="masthead">
    <div class="wrap masthead-inner">
      <a class="brand" href="<%= url_for('/') %>" aria-label="<%= config.title %>首页">
        <span class="brand-mark"><svg aria-hidden="true" viewBox="0 0 32 24"><use href="#i-wing"/></svg></span>
        <span><strong><%= config.title %></strong><small lang="en">GUGU POST</small></span>
      </a>
      <nav class="primary-nav" aria-label="主导航">
        <% [['home','首页','/'], ['archive','文章归档',config.archive_dir + '/'], ['topics','分类索引',config.category_dir + '/'], ['visual','实验室',theme.menu.Visual?.url], ['about','关于','about/']].filter(item => item[2]).forEach(([key, label, path]) => { %>
          <a href="<%= url_for(path) %>"<%- navKey === key ? ' aria-current="page"' : '' %>><%= label %></a>
        <% }) %>
      </nav>
      <div class="header-tools">
        <button class="search-trigger" type="button" data-search-open hidden aria-label="搜索文章" aria-haspopup="dialog"><%- partial('_postal/icon', { name: 'search' }) %><span>搜索</span><kbd>/</kbd></button>
        <% if (theme.dark.on) { %>
          <button type="button" class="icon-btn theme-trigger" data-theme-toggle hidden aria-label="夜间模式" title="夜间模式"><svg class="icon" aria-hidden="true"><use class="moon" href="#i-moon"/><use class="sun" href="#i-sun"/></svg></button>
        <% } %>
      </div>
    </div>
  </header>
  <main id="main-content" class="wrap" tabindex="-1"><%- body %></main>
  <footer class="site-footer">
    <div class="wrap footer-inner">
      <a class="footer-signature" href="<%= url_for('/') %>"><%- partial('_postal/icon', { name: 'mail' }) %> 咕嘎邮便局 <span>·</span> <%= config.author %></a>
      <nav aria-label="页脚导航">
        <% if (theme.Github.on) { %><a href="<%= theme.Github.url %>">GitHub</a><% } %>
        <a href="<%= url_for('tags/') %>">标签</a>
        <a href="<%= url_for('visualization-layout/') %>">可视化实验</a>
        <a href="#main-content">回到顶部</a>
      </nav>
    </div>
  </footer>
  <% if (theme.search.on) { %><%- partial('_postal/search') %><% } %>
</body>
</html>
